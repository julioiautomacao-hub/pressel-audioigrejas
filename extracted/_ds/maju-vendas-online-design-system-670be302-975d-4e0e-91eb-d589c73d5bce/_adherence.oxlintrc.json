{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/layout/**",
              "components/media/**",
              "doc-page.js",
              "ui_kits/landing-afiliado/**",
              "ui_kits/site-institucional/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Source Sans 3|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Source Sans 3, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AffiliateDisclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<AffiliateDisclosure> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='AffiliateDisclosure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:inline|compact)$/]",
        "message": "<AffiliateDisclosure> tone must be one of 'inline' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|fullWidth|href|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, fullWidth, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:action|brand|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'action' | 'brand' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|dot|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, variant, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:verified|discount|category|brand|affiliate)$/]",
        "message": "<Chip> variant must be one of 'verified' | 'discount' | 'category' | 'brand' | 'affiliate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:meta|title|blurb|imageLabel|imageSrc|ctaLabel|onCta|key|ref|className|style|children)$/]",
        "message": "<CourseCard> doesn't accept that prop. Declared props: meta, title, blurb, imageLabel, imageSrc, ctaLabel, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|title|body|primaryLabel|secondaryLabel|proof|tone|imageLabel|imageSrc|onPrimary|onSecondary|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: badge, title, body, primaryLabel, secondaryLabel, proof, tone, imageLabel, imageSrc, onPrimary, onSecondary."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|brand)$/]",
        "message": "<Hero> tone must be one of 'light' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|height|radius|tone|key|ref|className|style|children)$/]",
        "message": "<ImagePlaceholder> doesn't accept that prop. Declared props: label, height, radius, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|teal)$/]",
        "message": "<ImagePlaceholder> tone must be one of 'sand' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|state|message|type|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, state, message, type, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus|error)$/]",
        "message": "<Input> state must be one of 'default' | 'focus' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|showTagline|showDot|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, size, showTagline, showDot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|negative|mono|onImage)$/]",
        "message": "<Logo> tone must be one of 'brand' | 'negative' | 'mono' | 'onImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|title|meta|excerpt|imageLabel|imageSrc|layout|href|key|ref|className|style|children)$/]",
        "message": "<PostCard> doesn't accept that prop. Declared props: category, title, meta, excerpt, imageLabel, imageSrc, layout, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|wide)$/]",
        "message": "<PostCard> layout must be one of 'stacked' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|name|blurb|price|oldPrice|discount|proof|imageLabel|imageSrc|ctaLabel|onCta|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: category, name, blurb, price, oldPrice, discount, proof, imageLabel, imageSrc, ctaLabel, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|actionLabel|onAction|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, actionLabel, onAction, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<SectionHeading> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|note|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: links, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|ctaLabel|onNavigate|onCta|sticky|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: items, active, ctaLabel, onNavigate, onCta, sticky."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
